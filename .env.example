# Host port mapping
BAIDU2API_HOST_PORT=8000

# Admin WebUI password/key
BAIDU2API_ADMIN_KEY=change-me

# Timezone
TZ=Asia/Shanghai

# Optional overrides (usually leave defaults)
# BAIDU2API_DATA_DIR=/app/data
# BAIDU2API_CONFIG_PATH=/app/data/config.toml
# BAIDU2API_COOKIE_FILE=/app/data/cookies.json

# docker-compose-dev.yml 构建基础镜像（国内源失败时可改）
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.13-slim
